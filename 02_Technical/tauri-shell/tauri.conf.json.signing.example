{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Order Get It Right",
  "version": "1.0.0",
  "identifier": "com.truthasaservice.ordergetitright",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Order Get It Right - Truth as a Service",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Truth as a Service",
    "longDescription": "Order Get It Right - deterministic business audit and valuation engine. 54-pattern deception ontology (v3.9), BBFB engine, Merkle truth ledger, ACL Section 56 demand generator, Section 177 affidavit compiler. No black boxes, no cloud AI, no network calls in the runtime.",
    "publisher": "Justin Barnett",
    "homepage": "https://truthasaservice.local",
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": "REPLACE_WITH_CERT_THUMBPRINT",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
