{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrderGetItRight",
  "version": "0.1.0",
  "identifier": "com.ordergetitright.app",
  "build": {
    "frontendDist": "./ui",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Order Get It Right",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "OrderGetItRight -- the forensic lie-detector for order management",
    "longDescription": "OrderGetItRight (OGIR) is a forensic lie-detector for regional e-commerce merchants. Upload an order file (PDF contract, email thread, invoice), the engine runs the lie-detector (55 patterns, R1-R6 applied), the result is an affidavit you can rely on.",
    "publisher": "Justin Barnett",
    "publisherName": "Justin Barnett",
    "homepage": "https://ordergetitright.com",
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": "OPERATOR_PASTES_SECTIGO_IV_THUMBPRINT",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "wix": {
        "language": "en-US",
        "fragmentPaths": [],
        "patch": []
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["en"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": "localhost",
      "signingIdentity": "OPERATOR_PASTES_APPLE_DEVELOPER_ID",
      "providerShortName": null,
      "entitlementsPath": "",
      "files": {}
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": [],
        "release": "1"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ordergetitright-updater.truth-project-official.workers.dev/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRTNDQjZBMzlGNkE4QjEKUldTeHFQWTVhc3ZqSDFKSkFzOHBPYzlrSDMvcUlDM0ZTTXVuRHkrcnd5TjJiMVB2bTgyaEZnRGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
